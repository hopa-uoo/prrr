//ЧАСТЬ 12: МЕТОДЫ МАССИВОВ ПОКРУЧЕ


// .filter() — оставить ТОЛЬКО те элементы, что проходят проверку
let numbers = [1, 2, 3, 4, 5, 6];
let even = numbers.filter(function(num) {
    return num % 2 === 0; // оставляем только чётные
});
// even = [2, 4, 6]

// Стрелочная запись (короче):
let big = numbers.filter(num => num > 3);
// big = [4, 5, 6]

// .filter() возвращает НОВЫЙ массив, исходный не меняется — это удобно!


