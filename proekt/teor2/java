//ЧАСТЬ 10: JSON (КАК СОХРАНЯТЬ СЛОЖНЫЕ ДАННЫЕ)


// Проблема: localStorage умеет хранить ТОЛЬКО текст (строки).
// А у нас часто есть массив или объект. Как сохранить список? Ответ — JSON.

let tasks = [
    { name: "Математика", date: "2026-11-05" },
    { name: "История", date: "2026-11-10" }
];

// JSON.stringify — превращает объект/массив в СТРОКУ (чтобы сохранить)
let text = JSON.stringify(tasks);
// text = '[{"name":"Математика","date":"2026-11-05"}, ...]'

// Ложем эту строку в браузер
localStorage.setItem('tasks', text);

// Когда достаём — превращаем строку ОБРАТНО в массив
let gotText = localStorage.getItem('tasks');
let tasksAgain = JSON.parse(gotText);
// tasksAgain — снова обычный массив, можно работать как раньше
console.log(tasksAgain[0].name); // "Математика"

// Запомни пару:
//   СОХРАНИТЬ -> JSON.stringify (объект в строку)
//   ПРОЧИТАТЬ -> JSON.parse (строку в объект)


